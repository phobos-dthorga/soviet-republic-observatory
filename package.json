{
  "name": "soviet-republic-observatory",
  "version": "0.3.0",
  "private": true,
  "description": "A local-first planning and statistical observatory for Workers & Resources: Soviet Republic saves.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run audit:ui",
    "build:web": "vite build",
    "desktop": "node scripts/run-with-short-cargo-target.mjs npx tauri dev",
    "desktop:build": "npm run desktop:build:binary && npm run ui:review -- run --suite smoke",
    "desktop:build:binary": "node scripts/run-with-short-cargo-target.mjs npx tauri build",
    "rust:check": "node scripts/run-with-short-cargo-target.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "node scripts/run-with-short-cargo-target.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:architecture": "node scripts/audit-architecture-boundaries.mjs",
    "audit:tesmio-probe": "node scripts/audit-tesmio-probe.mjs",
    "audit:ui": "playwright test",
    "audit:contrast": "playwright test tests/accessibility/contrast.spec.ts",
    "ui:review:setup": "node scripts/setup-ui-review.mjs",
    "ui:review": "node scripts/ui-review.mjs",
    "check": "npm run audit:localization && npm run audit:architecture && npm run audit:tesmio-probe && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:clippy": "node scripts/run-with-short-cargo-target.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "echarts": "6.1.0",
    "svelte": "^5.56.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/webdriverio": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "@wdio/tauri-service": "1.3.0",
    "ajv": "^8.20.0",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.7.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "^7.1.3",
    "vitest": "4.1.10",
    "webdriverio": "9.31.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "serialize-javascript": "7.1.1"
  }
}
