{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phobos-dthorga/soviet-republic-observatory/schemas/compatibility-profile-v1.schema.json",
  "title": "Republic Observatory W&R compatibility profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "parser_engine_api_version",
    "author",
    "description",
    "targets",
    "content_hash",
    "mappings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "parser_engine_api_version": { "const": "1.0.0" },
    "author": { "$ref": "#/$defs/inertText120" },
    "description": { "$ref": "#/$defs/inertText500" },
    "targets": { "$ref": "#/$defs/targets" },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extends": { "$ref": "#/$defs/baseReference" },
    "mappings": { "$ref": "#/$defs/mappings" }
  },
  "$defs": {
    "inertText120": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "not": {
        "pattern": "[<>]|https?://|javascript:|file://|(?:SELECT|INSERT|UPDATE|DELETE) |function\\(|=>|[A-Za-z]:[\\\\/]"
      }
    },
    "inertText500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "pattern": "[<>]|https?://|javascript:|file://|(?:SELECT|INSERT|UPDATE|DELETE) |function\\(|=>|[A-Za-z]:[\\\\/]"
      }
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_versions", "build_ids", "stats_formats"],
      "properties": {
        "game_versions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "build_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{1,20}$" }
        },
        "stats_formats": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        }
      }
    },
    "baseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogue_scopes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/catalogueScope" }
        },
        "archive_entries": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/archiveEntry" }
        },
        "stats_markers": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/statsMarker" }
        },
        "stats_fields": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/statsField" }
        },
        "definition_directives": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/definitionDirective" }
        },
        "binary_layouts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/binaryLayout" }
        }
      }
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "not": { "pattern": "[\\r\\n\\u0000]" }
      }
    },
    "archiveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "aliases"],
      "properties": {
        "slot": { "enum": ["stats"] },
        "aliases": { "$ref": "#/$defs/aliases" }
      }
    },
    "statsMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "aliases"],
      "properties": {
        "slot": {
          "enum": [
            "format",
            "history_record",
            "current_state",
            "city",
            "date_year",
            "date_day"
          ]
        },
        "aliases": { "$ref": "#/$defs/aliases" },
        "accepted_values": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        }
      }
    },
    "statsField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_slot", "aliases", "contexts"],
      "properties": {
        "host_slot": { "$ref": "#/$defs/hostSlot" },
        "aliases": { "$ref": "#/$defs/aliases" },
        "value_index": { "type": "integer", "minimum": 0, "maximum": 8 },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["history", "republic", "city"] }
        }
      }
    },
    "directiveMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["exact", "prefix", "contains"] },
        "value": {
          "type": "string",
          "minLength": 2,
          "maxLength": 96,
          "pattern": "^\\$?[A-Z0-9_]+$"
        }
      }
    },
    "definitionDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "matches"],
      "properties": {
        "id": { "$ref": "#/$defs/mappingId" },
        "operation": {
          "enum": [
            "building.construction_phase",
            "definition.display_name",
            "definition.name_token",
            "building.style",
            "building.workers_required",
            "building.professors_required",
            "building.service_capacity",
            "building.quality_of_living",
            "building.vehicle_capacity",
            "building.pollution_class",
            "building.sewage_pollution_factor",
            "building.water_required_quality",
            "building.water_industry_substation_disabled",
            "building.production_sewage_disabled",
            "building.sewage_disabled",
            "vehicle.type",
            "vehicle.family",
            "vehicle.country",
            "definition.availability",
            "vehicle.lifespan",
            "vehicle.cost_rub",
            "vehicle.cost_usd",
            "vehicle.speed",
            "vehicle.power",
            "vehicle.empty_weight",
            "vehicle.consumption",
            "vehicle.resource_capacity",
            "vehicle.transport_type",
            "vehicle.resource_allowed",
            "production.output",
            "production.input",
            "production.input_per_second",
            "production.waste_input",
            "construction.material_explicit",
            "construction.material_auto",
            "construction.node",
            "construction.keyword",
            "building.type",
            "vehicle.skill",
            "storage.capacity",
            "definition.repair_or_maintenance"
          ]
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/directiveMatch" }
        },
        "catalogue_scope": { "$ref": "#/$defs/mappingId" }
      }
    },
    "mappingId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "catalogueScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "acknowledged_content_hash",
        "update_policy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/mappingId" },
        "source_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 105,
          "pattern": "^(?:workshop|wip)\\.[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "acknowledged_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "update_policy": { "enum": ["exact", "track_updates"] }
      }
    },
    "binaryLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entry_name",
        "byte_order",
        "base_offset",
        "record_count",
        "stride",
        "max_records",
        "magic_checks",
        "fields"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$" },
        "entry_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "not": {
            "pattern": "^(?:/|\\\\|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)|[*?]"
          }
        },
        "byte_order": { "enum": ["little", "big"] },
        "base_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "record_count": { "$ref": "#/$defs/recordCount" },
        "stride": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "magic_checks": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/magicCheck" }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/binaryField" }
        }
      }
    },
    "recordCount": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed" },
            "value": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "primitive"],
          "properties": {
            "kind": { "const": "field" },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "primitive": { "enum": ["u8", "u16", "u32", "u64"] }
          }
        }
      ]
    },
    "magicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "bytes_hex"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "bytes_hex": {
          "type": "string",
          "pattern": "^(?:[0-9A-Fa-f]{2}){1,64}$"
        }
      }
    },
    "binaryField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_slot", "offset", "primitive"],
      "properties": {
        "host_slot": { "$ref": "#/$defs/hostSlot" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "primitive": {
          "enum": [
            "u8",
            "i8",
            "u16",
            "i16",
            "u32",
            "i32",
            "u64",
            "i64",
            "f32",
            "f64"
          ]
        },
        "mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": -1000000000,
          "exclusiveMaximum": 1000000000,
          "not": { "const": 0 }
        },
        "missing_values": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "number" }
        }
      }
    },
    "hostSlot": {
      "enum": [
        "core.citizens.electronics.none",
        "core.citizens.electronics.radio",
        "core.citizens.electronics.television",
        "core.citizens.electronics.computer",
        "core.citizens.status.happiness",
        "core.citizens.status.food_satisfaction",
        "core.citizens.status.health",
        "core.citizens.status.government_loyalty",
        "core.citizens.status.alcohol_addiction",
        "core.citizens.status.culture_enjoyment",
        "core.citizens.status.sports_enjoyment",
        "core.citizens.status.religion_sympathy",
        "core.citizens.status.clothing_quality",
        "source.stats.citizens.born",
        "source.stats.citizens.dead",
        "source.stats.citizens.escaped",
        "source.stats.citizens.immigrant_soviet",
        "source.stats.citizens.immigrant_africa",
        "source.stats.citizens.small_children",
        "source.stats.citizens.medium_children",
        "source.stats.citizens.adults_parent",
        "source.stats.citizens.adults",
        "source.stats.citizens.unemployed",
        "source.stats.citizens.no_education",
        "source.stats.citizens.basic_education",
        "source.stats.citizens.higher_education",
        "source.stats.citizens.car_owners",
        "market.price.purchase.rub",
        "market.price.purchase.usd",
        "market.price.sell.rub",
        "market.price.sell.usd",
        "market.price.base.rub",
        "market.price.base.usd",
        "market.trade.import.standard.rub",
        "market.trade.import.standard.usd",
        "market.trade.export.standard.rub",
        "market.trade.export.standard.usd",
        "market.trade.import.international.rub",
        "market.trade.import.international.usd",
        "market.trade.export.international.rub",
        "market.trade.export.international.usd",
        "market.cost.delivery.rub",
        "market.cost.delivery.usd",
        "market.cost.labour.rub",
        "market.cost.labour.usd",
        "market.cost.immigrant.rub",
        "market.cost.immigrant.usd",
        "market.tourism.visitors",
        "market.tourism.hotel_nights",
        "market.tourism.spending.rub",
        "market.tourism.spending.usd",
        "market.loan.balance.rub",
        "market.loan.balance.usd",
        "market.loan.interest.rub",
        "market.loan.interest.usd",
        "market.vehicle.import.rub",
        "market.vehicle.import.usd",
        "market.vehicle.export.rub",
        "market.vehicle.export.usd",
        "environment.activity.production",
        "environment.activity.construction_use",
        "environment.activity.factory_use",
        "environment.activity.shop_use",
        "environment.activity.vehicle_use",
        "environment.waste.factory",
        "environment.waste.citizen",
        "environment.waste.demolition"
      ]
    }
  }
}
